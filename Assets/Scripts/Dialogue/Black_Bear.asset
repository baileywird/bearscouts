  npcName: Black Bear
  npcPortrait: {fileID: -2063535435, guid: 2277d390f85784b4886058b001cd41e9, type: 3}
  dialogueLines:
  - "Hey! New here right? Don\u2019t worry, it doesn\u2019t take long to get the
    hang of how Camp Koda works...didn\u2019t for me anyway."
  - "I\u2019ve been coming here since I was a fresh cub, pretty sure I\u2019ve got
    more badges than the other bears combined."
  - "You may wanna do some pushups, tug of war contest is coming up next week...as
    long as you have me on your team you\u2019ll be fine!"
